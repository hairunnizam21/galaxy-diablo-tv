<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <gradient android:angle="90"
                        android:startColor="#3322D3EE"
                        android:endColor="#0022D3EE" />
                </shape>
            </item>
            <item android:width="3dp" android:gravity="start">
                <shape android:shape="rectangle">
                    <gradient android:angle="270"
                        android:startColor="#FF67E8F9"
                        android:endColor="#FF22D3EE" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <gradient android:angle="135"
                android:startColor="#FF22D3EE"
                android:endColor="#FF3B82F6" />
            <stroke android:width="1dp" android:color="@color/white" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#FF112A4D" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
        </shape>
    </item>
</selector>
