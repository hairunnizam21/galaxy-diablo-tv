<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#FF112A4D" />
            <corners android:radius="10dp" />
            <stroke android:width="2dp" android:color="#FF22D3EE" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#FF0B1A33" />
            <corners android:radius="10dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#660B1A33" />
            <corners android:radius="10dp" />
            <stroke android:width="1dp" android:color="#5522D3EE" />
        </shape>
    </item>
</selector>
