<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="135"
                android:startColor="#FF030712"
                android:centerColor="#FF071A35"
                android:endColor="#FF0E2E5C"
                android:type="linear" />
        </shape>
    </item>
    <!-- Cyan glow corner -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="radial"
                android:gradientRadius="600"
                android:centerX="0.8"
                android:centerY="0.2"
                android:startColor="#4422D3EE"
                android:endColor="#0022D3EE" />
        </shape>
    </item>
    <!-- Blue glow opposite -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="radial"
                android:gradientRadius="500"
                android:centerX="0.15"
                android:centerY="0.85"
                android:startColor="#553B82F6"
                android:endColor="#003B82F6" />
        </shape>
    </item>
</layer-list>
