<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="135"
                android:startColor="#E60B1A33"
                android:centerColor="#E60E2E5C"
                android:endColor="#E61D4ED8"
                android:type="linear" />
            <corners android:radius="24dp" />
            <stroke
                android:width="1dp"
                android:color="#9922D3EE" />
            <padding
                android:bottom="14dp"
                android:left="20dp"
                android:right="20dp"
                android:top="14dp" />
        </shape>
    </item>
</layer-list>
